<?xml version="1.0" encoding="utf-8"?>
<!-- Dark field with a single crimson underline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/panel" /></shape></item>
    <item android:left="-2dp" android:right="-2dp" android:top="-2dp">
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/crimson" />
        </shape>
    </item>
</layer-list>
